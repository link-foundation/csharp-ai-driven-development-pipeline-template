<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!-- CA1303: a console sample prints literals, not localized resources -->
    <!-- CA2007: console apps have no SynchronizationContext to avoid -->
    <NoWarn>$(NoWarn);CA1303;CA2007</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\src\MyPackage\MyPackage.csproj" />
  </ItemGroup>

</Project>
